
include $(SRCDIR)/config/aros.cfg

ARCHFILES := pciusb_init
PCIXHCIDIR := rom/usb/pcixhci

-include $(SRCDIR)/$(CURDIR)/make.opts
-include $(SRCDIR)/$(PCIXHCIDIR)/make.opts

USER_LDFLAGS := -static
USER_INCLUDES := -I$(SRCDIR)/$(CURDIR) -I$(SRCDIR)/$(PCIXHCIDIR)

#MM kernel-usb-pcixhci-pc : kernel-acpica-sharedlib-includes

%build_archspecific \
  mainmmake=kernel-usb-pcixhci maindir=$(PCIXHCIDIR) \
  arch=pc modname=pcixhci \
  files="$(ARCHFILES)"
